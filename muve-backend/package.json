{
  "name": "muve-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --require ts-node/register --test --test-concurrency=1 test/unit/*.test.ts",
    "pretest:integration": "prisma generate",
    "test:integration": "node --require ts-node/register --test --test-concurrency=1 test/integration/*.test.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:gen": "prisma generate",
    "prisma:mig": "prisma migrate dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "prisma": "^6.16.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
